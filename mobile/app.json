{
  "expo": {
    "name": "Hatırlaf",
    "slug": "hatirlaf",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hatirlaf",
    "jsEngine": "jsc",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Hatırlaf sesli günlük kayıtlarını oluşturmak için mikrofona ihtiyaç duyar."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-audio",
      "expo-secure-store",
      "expo-notifications",
      "expo-background-task"
    ],
    "extra": {
      "defaultApiBase": "http://127.0.0.1:8001/api"
    }
  }
}
