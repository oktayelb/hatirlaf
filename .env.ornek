# Bu PC'de kalan sirlar. .gitignore'da; ASLA commit edilmez ve
# HICBIRI uygulama derlemesine girmez.
#
# Derlemeye GIREN sirlar buraya DEGIL yedek.json'a yazilir
# (B2_KEY_ID, B2_APP_KEY, B2_BUCKET_ID, YEDEK_ALICI_ANAHTARI).
# Onlar APK'nin icine gomulur; gizli tutulmalari zaten mumkun degil,
# bu yuzden B2 anahtari yalnizca writeFiles yetkili olmali.
#
# Ayrintilar: docs/yedekleme.md, docs/guncelleme.md

# --- Backblaze hesabi (tam yetki; yalnizca indirme/yonetim icin) ------
B2_ACCOUNT_EMAIL=
B2_ACCOUNT_PASSWORD=
B2_MASTER_API_KEYID=
# Master anahtarin GIZLI kismi (K00... ile baslar). Yalnizca
# uretildigi anda bir kez gosterilir; kaybolduysa konsoldan
# yeni bir master anahtar uretin.
B2_MASTER_API_KEY=

# --- Android yayin imzasi ---------------------------------------------
# APK'yi IMZALAMAKTA kullanilir, APK'nin ICINE girmez. Kaybolursa bir
# daha guncelleme yayinlanamaz ve tek cikis uygulamayi silmek -- o da
# butun hatiralari siler.
ANDROID_KEYSTORE=android/hatirlaf.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# --- Yedek cozme anahtari ---------------------------------------------
# X25519 GIZLI anahtari. Telefonlara yalnizca ACIK esi gider.
# Kaybolursa B2'deki her sey cozulemez hale gelir.
YEDEK_GIZLI_ANAHTAR=~/hatirlaf-yedek-anahtari.gizli
